{
  "worktree": {
    "baseRef": "head"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true,
    "prisma@pleaseai": true,
    "zod@pleaseai": true,
    "tanstack-query@tanstack-skills": true,
    "tanstack-table@tanstack-skills": true,
    "tanstack-form@tanstack-skills": true,
    "fullstack-dev-skills@fullstack-dev-skills": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/zibar/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/zibar/.local/bin/graphify hook-guard read"
          }
        ]
      }
    ]
  }
}