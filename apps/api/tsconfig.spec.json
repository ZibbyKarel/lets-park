{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "moduleResolution": "bundler",
    // ts-jest transpiles the ESM-only `@orpc/*` and `@nestjs/config` packages
    // into CommonJS for Jest (see `jest.config.cts`), which means it has to be
    // willing to read `.js`/`.mjs` in the first place.
    "allowJs": true,
    // `ical.js` (a test-only devDependency, used by the calendar pipeline spec
    // to parse the served feed with an independent RFC 5545 implementation)
    // declares `export default` but ships a plain CommonJS namespace with no
    // `__esModule` marker and no `default` key. Without this flag ts-jest emits
    // `require("ical.js").default`, which is `undefined` at run time while the
    // import typechecks. Spec files only — `tsconfig.app.json` is untouched, so
    // nothing shipped changes shape.
    "esModuleInterop": true,
    "types": ["jest", "node"]
  },
  "include": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    // Spec-only support code, excluded from `tsconfig.app.json` so it can never
    // become part of the application program. It is included here so that it is
    // still typechecked by `nx typecheck`.
    "src/**/testing/**/*.ts"
  ]
}
