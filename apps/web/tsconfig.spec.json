{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["jest", "node"]
  },
  // Without its own `exclude`, this config would inherit `tsconfig.json`'s —
  // and since that parent's exclude glob deliberately matches every
  // `.spec.*`/`.test.*` extension this file's own `include` below lists,
  // inheriting it would silently empty this program to zero files (see
  // `doc/decision/0126-*`). An explicit empty override is the fix.
  "exclude": [],
  "include": [
    "index.d.ts",
    "next-env.d.ts",
    "src/test-setup.ts",
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/**/*.d.ts",
    "specs/**/*.test.ts",
    "specs/**/*.spec.ts",
    "specs/**/*.test.tsx",
    "specs/**/*.spec.tsx",
    "specs/**/*.d.ts"
  ]
}
