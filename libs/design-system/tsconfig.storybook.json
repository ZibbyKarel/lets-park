{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "@nx/react/typings/cssmodule.d.ts"]
  },
  "include": [".storybook/**/*.ts", "src/**/*.stories.tsx", "src/**/*.tsx", "src/**/*.ts"],
  "exclude": ["src/**/*.spec.tsx", "src/**/*.spec.ts"]
}
