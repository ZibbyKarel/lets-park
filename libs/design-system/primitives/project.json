{
  "name": "design-system-primitives",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/design-system/primitives/src",
  "projectType": "library",
  "tags": ["type:ui", "scope:web", "ds:primitives"],
  "// targets": "to see all targets run: nx show project design-system-primitives --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p libs/design-system/primitives/tsconfig.lib.json",
          "tsc --noEmit -p libs/design-system/primitives/tsconfig.spec.json",
          "tsc --noEmit -p libs/design-system/primitives/tsconfig.storybook.json"
        ],
        "parallel": false
      }
    },
    "storybook": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook dev --port 4400 --no-open",
        "cwd": "libs/design-system/primitives"
      }
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/storybook/design-system-primitives"],
      "options": {
        "command": "storybook build --output-dir ../../../dist/storybook/design-system-primitives",
        "cwd": "libs/design-system/primitives"
      }
    }
  }
}
