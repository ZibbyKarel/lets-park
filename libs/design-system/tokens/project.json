{
  "name": "design-system-tokens",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/design-system/tokens/src",
  "projectType": "library",
  "tags": ["type:ui", "scope:web", "ds:tokens"],
  "// targets": "to see all targets run: nx show project design-system-tokens --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p libs/design-system/tokens/tsconfig.lib.json",
          "tsc --noEmit -p libs/design-system/tokens/tsconfig.spec.json",
          "tsc --noEmit -p libs/design-system/tokens/tsconfig.scripts.json"
        ],
        "parallel": false
      }
    },
    "generate-css": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r ts-node/register/transpile-only scripts/build-tokens-css.ts",
        "cwd": "libs/design-system/tokens",
        "env": {
          "TS_NODE_PROJECT": "tsconfig.scripts.json"
        }
      }
    }
  }
}
