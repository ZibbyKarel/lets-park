{
  "name": "database",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/database/src",
  "projectType": "library",
  "tags": ["type:data", "scope:api"],
  "// targets": "to see all targets run: nx show project database --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p libs/database/tsconfig.lib.json",
          "tsc --noEmit -p libs/database/tsconfig.spec.json"
        ],
        "parallel": false
      }
    },
    "prisma-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma generate",
        "cwd": "{workspaceRoot}"
      },
      "inputs": ["{projectRoot}/prisma/schema.prisma"],
      "outputs": ["{projectRoot}/src/generated"],
      "cache": true
    }
  }
}
