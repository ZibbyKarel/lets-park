{
  "name": "i18n",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/i18n/src",
  "projectType": "library",
  "tags": ["type:util", "scope:web", "app:shared"],
  "// targets": "to see all targets run: nx show project i18n --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p libs/shared/i18n/tsconfig.lib.json",
          "tsc --noEmit -p libs/shared/i18n/tsconfig.spec.json"
        ],
        "parallel": false
      }
    }
  }
}
