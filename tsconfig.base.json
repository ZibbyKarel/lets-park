{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@lets-park/contract": ["./libs/lets-park/contract/src/index.ts"],
      "@lets-park/contract/realtime": ["./libs/lets-park/contract/src/realtime/index.ts"],
      "@lets-park/design-system/compounds": ["./libs/shared/design-system/src/compounds/index.ts"],
      "@lets-park/design-system/primitives": [
        "./libs/shared/design-system/src/primitives/index.ts"
      ],
      "@lets-park/design-system/tokens": ["./libs/shared/design-system/src/tokens/index.ts"],
      "@lets-park/shared-types": ["./libs/lets-park/shared-types/src/index.ts"],
      "@lets-park/calendar-export": ["./libs/lets-park/calendar-export/src/index.ts"],
      "@lets-park/database": ["./libs/lets-park/database/src/index.ts"],
      "@lets-park/i18n": ["./libs/shared/i18n/src/index.ts"],
      "@lets-park/form": ["./libs/shared/form/src/index.ts"],
      "@lets-park/api-client": ["./libs/shared/api-client/src/index.ts"],
      "@lets-park/auth": ["./libs/lets-park/auth/src/index.ts"],
      "@lets-park/auth/client": ["./libs/lets-park/auth/src/client/index.ts"],
      "@lets-park/realtime-client": ["./libs/lets-park/realtime-client/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
