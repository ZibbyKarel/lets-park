# Editor configuration, see http://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx,cjs,cts,mjs,mts,json,jsonc,css,scss,yml,yaml}]
max_line_length = 100

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[*.{ico,png,jpg,jpeg,otf,ttf,woff,woff2}]
insert_final_newline = false
trim_trailing_whitespace = false
